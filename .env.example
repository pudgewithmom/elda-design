NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS and PostgreSQL
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://elda:elda@127.0.0.1:5433/elda
# Optional local override for Windows paths containing apostrophes:
# PAYLOAD_MIGRATION_DIR=C:/path-without-apostrophes/to/project/src/migrations

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_IDS=

# Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Future S3-compatible media storage
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
